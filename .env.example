# --- Lokalizacja ---
# city_id i region_id znajdziesz w źródle strony OLX (szukaj city_id= w HTML)
# lub przez: https://www.olx.pl/api/v1/geo/cities/?query=<miasto>
CITY_ID=36783
REGION_ID=3
# Promień w km — wymaga STRATEGY=extended_distance żeby działał
DIST=5
STRATEGY=extended_distance

# --- Filtry ---
PRICE_FROM=2000
PRICE_TO=3500
AREA_FROM=40
AREA_TO=70
# Pokoje: one,two,three,four (przecinkami, bez spacji)
ROOMS=two,three,four
# Typ budynku: blok,kamienica,wolnostojacy,szeregowiec (zostaw puste = bez filtra)
BUILTTYPES=

# --- Sortowanie i paginacja ---
SORT_BY=created_at:desc
LIMIT=40

# --- Aplikacja ---
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:AAH-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=
POLL_SECONDS=60
SEEN_FILE=history.json
